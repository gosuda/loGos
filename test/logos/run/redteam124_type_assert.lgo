// run -O=3

package main

import (
	"fmt"
	"io"
	"net/http"
)

// REDTEAM #124 (SPEC Sec 2.3, T-203.4; IMPLEMENTATION.md M13-S3): a dynamic
// assertion inside a specialized clone must give the same result as the
// unspecialized call, and function values must keep working. r124Emit
// specializes per concrete writer type with the http.Flusher assertion
// folded per type, while a call through an io.Writer value keeps the
// original with its dynamic assertion. Distinct from
// test/logos/run/specialize_assert.lgo, which pins the same property with
// different types and counts; this fixture is the #124 close-out probe.

type r124Plain struct{ n int }

func (p *r124Plain) Write(b []byte) (int, error) {
	p.n += len(b)
	return len(b), nil
}

type r124Flush struct {
	n int
	f int
}

func (f *r124Flush) Write(b []byte) (int, error) {
	f.n += len(b)
	return len(b), nil
}

func (f *r124Flush) Flush() { f.f++ }

func r124Emit(w io.Writer, msg string) string {
	if _, err := w.Write([]byte(msg)); err != nil {
		return err.Error()
	}
	if f, ok := w.(http.Flusher); ok {
		f.Flush()
		return "flushed"
	}
	return "buffered"
}

func main() {
	var pw r124Plain
	var fw r124Flush
	fmt.Println(r124Emit(&pw, "a"), r124Emit(&fw, "bc"), r124Emit(&fw, "d"))
	fmt.Println(pw.n, fw.n, fw.f)
	var fn func(io.Writer, string) string = r124Emit
	fmt.Println(fn(&pw, "x"), fn(&fw, "y"))
	var dyn io.Writer = &fw
	fmt.Println(r124Emit(dyn, "z"), fw.f)
}
