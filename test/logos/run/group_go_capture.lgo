// run -t 30

// PRRT_kwDOVOeymc6vs5oM (lowerGroupGo): operands of `go f(args)` in a group
// body evaluate in the calling goroutine at the go statement, before
// Group.Go, in source order (callee or receiver, then arguments). The child
// runs only the call. Success prints nothing and exits 0, so the expected
// stdout is empty and no .out file is needed.
//
// Truth source: Go spec, "Go statements": the function value and parameters
// are evaluated as usual in the calling goroutine; the invoked function runs
// without the caller waiting for it. The same program with plain go
// statements (no limit) is valid Go and prints nothing.
//
// Channel barriers only, no sleeps. operandsBeforeGo is written so that the
// operand closes the gate that the token-holding child waits on. Under
// evaluation-in-child lowering, the second Group.Go blocks on the single
// token, the holder waits on the gate, and nothing else can run.

package main

import (
	"context"
	"fmt"
	"os"
)

func panicArg() string {
	panic("parent-arg-panic")
}

func ignoreArg(s string) error {
	return nil
}

// panicUnwindsParent: an argument panic must unwind the caller at the go
// statement. A group error (a *rt.PanicError) means the argument ran in the
// child.
func panicUnwindsParent(ctx context.Context) (err error) {
	defer func() {
		r := recover()
		if r == nil {
			if err == nil {
				err = fmt.Errorf("argument panic did not reach the caller")
			}
			return
		}
		err = nil
		if r != "parent-arg-panic" {
			err = fmt.Errorf("recovered %v, want parent-arg-panic", r)
		}
	}()
	go group (ctx) {
		go ignoreArg(panicArg())
	}
	return nil
}

func multiVal() (int, string) {
	return 42, "hello"
}

//logos:allow(correctness::unbounded_channel_op)
func sumWorker(out chan string, tag string, nums ...int) error {
	sum := 0
	for _, v := range nums {
		sum += v
	}
	out <- fmt.Sprintf("%s:%d", tag, sum)
	return nil
}

// multiValuedArgs: a multi-valued call as the sole argument, a variadic
// spread, and variadic literals must keep every value.
//logos:allow(correctness::unbounded_channel_op)
func multiValuedArgs(ctx context.Context) error {
	pair := make(chan string, 1)
	spread := make(chan string, 1)
	literal := make(chan string, 1)
	sendPair := func(n int, s string) error {
		pair <- fmt.Sprintf("%d:%s", n, s)
		return nil
	}
	nums := []int{1, 2, 3}
	go group (ctx) {
		go sendPair(multiVal())
		go sumWorker(spread, "spread", nums...)
		go sumWorker(literal, "literal", 4, 5)
	}
	if got := <-pair; got != "42:hello" {
		return fmt.Errorf("multi-valued call gave %q, want 42:hello", got)
	}
	if got := <-spread; got != "spread:6" {
		return fmt.Errorf("variadic spread gave %q, want spread:6", got)
	}
	if got := <-literal; got != "literal:9" {
		return fmt.Errorf("variadic literals gave %q, want literal:9", got)
	}
	return nil
}

type svc struct {
	tag string
	got chan string
}

//logos:allow(correctness::unbounded_channel_op)
func (s *svc) Work(v int) error {
	s.got <- fmt.Sprintf("%s:%d", s.tag, v)
	return nil
}

// receiverOnce: the receiver expression and the callee expression each
// evaluate exactly once, and each argument expression evaluates exactly once.
// Counts are read after the group joins, so they are final.
//logos:allow(correctness::unbounded_channel_op)
func receiverOnce(ctx context.Context) error {
	recv := make(chan string, 1)
	pgot := make(chan string, 1)
	mkCalls, pickCalls, argCalls := 0, 0, 0
	mk := func() *svc {
		mkCalls++
		return &svc{tag: "s", got: recv}
	}
	arg := func() int {
		argCalls++
		return 7
	}
	pick := func() func(int) error {
		pickCalls++
		return func(v int) error {
			pgot <- fmt.Sprintf("p:%d", v)
			return nil
		}
	}
	go group (ctx) {
		go mk().Work(arg())
		go pick()(arg())
	}
	if mkCalls != 1 || pickCalls != 1 || argCalls != 2 {
		return fmt.Errorf("evaluations mk=%d pick=%d arg=%d, want 1 1 2", mkCalls, pickCalls, argCalls)
	}
	if got := <-recv; got != "s:7" {
		return fmt.Errorf("receiver call gave %q, want s:7", got)
	}
	if got := <-pgot; got != "p:7" {
		return fmt.Errorf("callee call gave %q, want p:7", got)
	}
	return nil
}

//logos:allow(correctness::unbounded_channel_op)
func holdToken(hold chan struct{}) error {
	<-hold
	return nil
}

//logos:allow(correctness::unbounded_channel_op)
func recordInt(got chan int, v int) error {
	got <- v
	return nil
}

// releaseWith records that its operand was evaluated, then closes the gate
// that holdToken waits on, and returns the operand value.
//logos:allow(correctness::unbounded_channel_op)
func releaseWith(hold chan struct{}, trace chan string, v int) int {
	trace <- "arg"
	close(hold)
	return v
}

// operandsBeforeGo: with limit = 1, holdToken occupies the only token until
// the second go statement's operand closes hold. The operand must run in the
// parent before Group.Go, and the parent's next statement must run after it.
// The second child must receive x as it was at the go statement (10), not
// after the parent's later write (999).
//logos:allow(correctness::unbounded_channel_op)
func operandsBeforeGo(ctx context.Context) error {
	hold := make(chan struct{})
	trace := make(chan string, 2)
	got := make(chan int, 1)
	x := 10
	go group (ctx, limit = 1) {
		go holdToken(hold)
		go recordInt(got, releaseWith(hold, trace, x))
		trace <- "post"
		x = 999
	}
	first, second := <-trace, <-trace
	if first != "arg" || second != "post" {
		return fmt.Errorf("order %q then %q, want arg then post", first, second)
	}
	if v := <-got; v != 10 {
		return fmt.Errorf("child got %d, want 10 captured at the go statement", v)
	}
	return nil
}

func report(name string, err error) bool {
	if err == nil {
		return false
	}
	fmt.Println("FAIL", name+":", err)
	return true
}

func main() {
	ctx := context.Background()
	bad := report("panicUnwindsParent", panicUnwindsParent(ctx))
	bad = report("multiValuedArgs", multiValuedArgs(ctx)) || bad
	bad = report("receiverOnce", receiverOnce(ctx)) || bad
	// Last: under evaluation-in-child lowering this check deadlocks, so the
	// checks above print their FAIL lines first.
	bad = report("operandsBeforeGo", operandsBeforeGo(ctx)) || bad
	if bad {
		os.Exit(1)
	}
}
