// run -O=1

package main

import "fmt"

// M13-S3 clone-alias suppression (SPEC T-203.4), the -O=1 side of
// specialize_alias.lgo: no clone exists, so every call converts the const
// argument through the const-slice lowering (a real copy) and the output
// equals the -O=3 output. There is no Go twin: const views are loGo/s
// syntax.

type Creature interface {
	const Name() string
}

type Monster struct{ name string }

func (m *Monster) Name() string { return m.name }

func Take(cs const []Creature, plain []*Monster) string {
	before := cs[0].Name()
	plain[0] = &Monster{"ogre"}
	return before + "," + cs[0].Name()
}

var (
	backing = []*Monster{{name: "orc"}}
	ag      = backing
	bg      = backing
	g       = []*Monster{{name: "orc"}}
)

func main() {
	ms := []*Monster{{name: "orc"}}
	fmt.Println(Take(ms, ms))

	fmt.Println(Take(ag, bg))

	local := g
	fmt.Println(Take(g, local))
}
