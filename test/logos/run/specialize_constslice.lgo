// run -O=3

package main

import "fmt"

// M13-S3 row #121 (SPEC T-203.4): a `const []Creature` parameter receiving
// a `[]*Monster` converts through the const-slice lowering (rt.CovSlice, a
// real copy) wherever the call stays as written, and at -O=3 specializes
// to a `const []*Monster` clone with no copy loop. Output is identical at
// both levels (specialize_constslice_o1.lgo runs this body at -O=1): a nil
// slice stays nil and a slice that is already a []Creature takes the
// original function. test/logos/codegen/specialize_constslice.lgo proves the
// no-copy clone. A *Monster is non-nil in loGo/s, so nil elements belong to
// the rt.CovSlice unit test. There is no Go twin: const views are loGo/s
// syntax.

type Creature interface {
	const Name() string
}

type Monster struct{ name string }

func (m *Monster) Name() string { return m.name }

func Names(cs const []Creature) string {
	out := ""
	for i, c := range cs {
		if i > 0 {
			out += ","
		}
		out += c.Name()
	}
	return out
}

func main() {
	ms := []*Monster{{name: "orc"}, {name: "troll"}, {name: "imp"}}
	fmt.Println(Names(ms))
	fmt.Println(Names(nil))
	var none []*Monster
	fmt.Println(len(Names(none)))
	cs := []Creature{&Monster{name: "elf"}}
	fmt.Println(Names(cs))
}
