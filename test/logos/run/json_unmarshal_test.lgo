// run

package jsonunmarshal

// M11-S2 attack (SPEC Sec 12.2, T-Sec12; rows #7, #123, #139): the generated
// UnmarshalJSON fills defaults first, enforces required non-nil fields
// through a seen mask, dispatches keys by switch or perfect-hash table,
// skips unknown keys, keeps the last duplicate, grows arrays as elements
// arrive, and is the method encoding/json reaches for both json.Unmarshal
// and json.NewDecoder. JSON has no length header, so a hostile array claim
// is only as large as the bytes that arrive.

import (
	"bytes"
	"encoding/json"
	"fmt"
	"math"
	"math/rand"
	"reflect"
	"runtime"
	"strings"
	"testing"

	"logos/rt"
)

type Profile struct {
	Bio string `json:"bio"`
}

type User struct {
	ID      int64    `json:"id"`
	Name    string   `json:"name"`
	Profile *Profile `json:"profile"`
}

type Cfg struct {
	Port int32  = 8080 `json:"port"`
	TLS  bool   = true `json:"tls"`
	Host string = "localhost" `json:"host"`
	Note string `json:"note"`
}

type Items struct {
	Items []int64 `json:"items"`
}

type Untagged struct {
	Inner *Profile
	Other int64
}

