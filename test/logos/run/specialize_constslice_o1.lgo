// run -O=1

package main

import "fmt"

// M13-S3 row #121 (SPEC T-203.4), the -O=1 side of
// specialize_constslice.lgo: no clone exists, so every call converts the
// []*Monster argument through the const-slice lowering (a real copy) and the
// output equals the -O=3 output.

type Creature interface {
	const Name() string
}

type Monster struct{ name string }

func (m *Monster) Name() string { return m.name }

func Names(cs const []Creature) string {
	out := ""
	for i, c := range cs {
		if i > 0 {
			out += ","
		}
		out += c.Name()
	}
	return out
}

func main() {
	ms := []*Monster{{name: "orc"}, {name: "troll"}, {name: "imp"}}
	fmt.Println(Names(ms))
	fmt.Println(Names(nil))
	var none []*Monster
	fmt.Println(len(Names(none)))
	cs := []Creature{&Monster{name: "elf"}}
	fmt.Println(Names(cs))
}
