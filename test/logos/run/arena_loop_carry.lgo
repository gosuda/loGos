// run -goexperiment logosarena

package main

// M18 loop-carry attack (SPEC Sec 3.1, Sec 8.3): loop back-edges must
// restore only iteration-local objects while retaining loop-carried state.
// Each loop below allocates a runtime-sized 1024-byte slice per iteration
// (size arrives as a function parameter, so the make is dynamic, not a
// constant). The first iteration saves its slice into an outer local; later
// iterations write different values into fresh makes. The saved checksum and
// edge bytes must stay independent after the loop and across runtime.GC().
// A buggy watermark that reclaims carried backing would alias the saved
// slice to a later iteration (e.g. basic keepSum 1024 becomes 4096).
// Value checks only: the existing loop-watermark pass proves bounded reuse
// for iteration-local loops but cannot prove carried retention, so no alloc
// counters are asserted here. Closures and a noinline callee retain the
// carried value; one loop threads the carried slice through Cond/Post;
// nested sibling inner loops split eligibility (first carries, second is
// iteration-local). The sole global is the genuine heap-escape control.
// No unsafe, no manual marks, all expected numbers are immutable.

import (
	"fmt"
	"runtime"
)

// Genuine escape control only: a slice stored to a global must stay heap
// and stay correct. No other package-level state.
var escapeSink []byte

//go:noinline
func sumBytes(b []byte) int {
	s := 0
	for _, v := range b {
		s += int(v)
	}
	return s
}

func carryBasic(n int) (ks, kf, kl, ls, lf, ksGC, lsGC int) {
	var kept []byte
	var last []byte
	for i := 0; i < 4; i++ {
		b := make([]byte, n)
		v := byte(i + 1)
		for j := range b {
			b[j] = v
		}
		if i == 0 {
			kept = b
		}
		last = b
	}
	ks = sumBytes(kept)
	kf = int(kept[0])
	kl = int(kept[n-1])
	ls = sumBytes(last)
	lf = int(last[0])
	runtime.GC()
	runtime.GC()
	ksGC = sumBytes(kept)
	lsGC = sumBytes(last)
	runtime.KeepAlive(kept)
	runtime.KeepAlive(last)
	return ks, kf, kl, ls, lf, ksGC, lsGC
}

func carryClosure(n int) (direct, via, after, viaAfter int) {
	var kept []byte
	for i := 0; i < 4; i++ {
		b := make([]byte, n)
		v := byte(20 + i)
		for j := range b {
			b[j] = v
		}
		if i == 0 {
			kept = b
		}
	}
	// Closure captures the outer carried slice after the loop, so the
	// captured backing is the loop-carried value itself; the closure never
	// escapes this function.
	get := func() int { return sumBytes(kept) }
	direct = sumBytes(kept)
	via = get()
	runtime.GC()
	runtime.GC()
	after = sumBytes(kept)
	viaAfter = get()
	runtime.KeepAlive(kept)
	return direct, via, after, viaAfter
}

func carryCondPost(n int) (total, ks, ksGC, os, osGC int) {
	outer := make([]byte, n)
	for j := range outer {
		outer[j] = 9
	}
	var kept []byte
	// Direct header makes: the Cond and Post expressions each contain a real
	// runtime-sized make in the loop-header block itself (not in a callee, so
	// header-visitor vetoes see it). Each header make is zeroed and consumed
	// by the noinline sumBytes, so the allocation is real and iteration-local
	// (dead after the check/step) while kept/outer stay live across it.
	// Cond is true 4 times then false; Post preserves i (x*0 terms vanish).
	for i := 0; i < 4 && len(kept) <= n && sumBytes(make([]byte, n)) == 0; i = i + 1 + sumBytes(make([]byte, n))*0 + len(kept)*0 {
		b := make([]byte, n)
		v := byte(40 + i)
		for j := range b {
			b[j] = v
		}
		if i == 0 {
			kept = b
		}
		total += int(b[0]) + int(b[n-1])
	}
	ks = sumBytes(kept)
	os = sumBytes(outer)
	runtime.GC()
	runtime.GC()
	ksGC = sumBytes(kept)
	osGC = sumBytes(outer)
	runtime.KeepAlive(kept)
	runtime.KeepAlive(outer)
	return total, ks, ksGC, os, osGC
}

func carryNested(n int) (ks, kf, innerTotal, ksGC int) {
	var kept []byte
	for i := 0; i < 3; i++ {
		for k := 0; k < 3; k++ {
			b := make([]byte, n)
			v := byte(50 + i*10 + k)
			for j := range b {
				b[j] = v
			}
			if i == 0 && k == 0 {
				kept = b
			} else {
				innerTotal += int(b[0])
			}
		}
		// Sibling inner loop at the same depth: purely iteration-local,
		// so it stays eligible for per-iteration reclaim while kept above
		// must be retained.
		for k := 0; k < 3; k++ {
			t := make([]byte, n)
			v := byte(90 + k)
			for j := range t {
				t[j] = v
			}
			innerTotal += int(t[0])
		}
	}
	ks = sumBytes(kept)
	kf = int(kept[0])
	runtime.GC()
	runtime.GC()
	ksGC = sumBytes(kept)
	runtime.KeepAlive(kept)
	return ks, kf, innerTotal, ksGC
}

func carryEscape(n int) (ks, es, ksGC, esGC int) {
	var kept []byte
	for i := 0; i < 4; i++ {
		b := make([]byte, n)
		v := byte(60 + i)
		for j := range b {
			b[j] = v
		}
		if i == 0 {
			kept = b
		}
		if i == 1 {
			escapeSink = b
		}
	}
	ks = sumBytes(kept)
	es = sumBytes(escapeSink)
	runtime.GC()
	runtime.GC()
	ksGC = sumBytes(kept)
	esGC = sumBytes(escapeSink)
	runtime.KeepAlive(kept)
	runtime.KeepAlive(escapeSink)
	return ks, es, ksGC, esGC
}

func main() {
	ks, kf, kl, ls, lf, ksGC, lsGC := carryBasic(1024)
	fmt.Println("basic:", ks, kf, kl, ls, lf, ksGC, lsGC)
	direct, via, after, viaAfter := carryClosure(1024)
	fmt.Println("closure:", direct, via, after, viaAfter)
	total, cks, cksGC, osum, osumGC := carryCondPost(1024)
	fmt.Println("condpost:", total, cks, cksGC, osum, osumGC)
	nks, nkf, ntotal, nksGC := carryNested(1024)
	fmt.Println("nested:", nks, nkf, ntotal, nksGC)
	eks, ees, eksGC, eesGC := carryEscape(1024)
	fmt.Println("escape:", eks, ees, eksGC, eesGC)
}
