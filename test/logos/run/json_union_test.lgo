// run

package jsonunion

// M11-S4 union JSON fixture (SPEC Sec 12.1, Sec 12.2, T-Sec12, T-203.1).
// Anchor: Tony Hoare, Edsger W. Dijkstra
//
// Closed union marshaling and unmarshaling:
// 1. A closed-union value marshals to its dynamic member's static bytes.
// 2. Unmarshal tries members in declaration order into fresh scratch values.
// 3. Exactly one success assigns the target.
// 4. Ambiguity returns an error naming the union and all member names; it is
//    neither MissingFieldError nor a Scanner syntax error.
// 5. Failed trials (both 0-match and ambiguous >1-match) leave the target
//    untouched, preserving pre-existing values.
// 6. Pointer members allocate fresh scratch per trial, never corrupting target
//    pointees on trial failure.
// 7. A member with an unmodeled field round-trips through its per-field
//    reflective fallback.
// 8. JSON null leaves the union field absent (nil).

import (
	"bytes"
	"encoding/json"
	"errors"
	"reflect"
	"strings"
	"testing"

	"logos/rt"
)

// Closed union over two tagged struct members.
type Shape interface {
	Circle | Square
}

type Circle struct {
	R int64 `json:"r"`
}

type Square struct {
	S int64 `json:"s"`
}

// Method-less mirror types for reflective oracle comparison.
// An open interface field (NoGen any) disqualifies the type from static methods.
type CircleMirror struct {
	R     int64 `json:"r"`
	NoGen any   `json:"-"`
}

type SquareMirror struct {
	S     int64 `json:"s"`
	NoGen any   `json:"-"`
}

type ShapeHolder struct {
	Item Shape `json:"item"`
}

type ShapeHolderMirror struct {
	Item  any `json:"item"`
	NoGen any `json:"-"`
}

// Overlapping union: both Alpha and Beta accept {"id":1}.
type OverlapUnion interface {
	Alpha | Beta
}

type Alpha struct {
	ID int64 `json:"id"`
}

type Beta struct {
	ID int64 `json:"id"`
}

type OverlapHolder struct {
	Item OverlapUnion `json:"item"`
}

// Pointer-term closed union (*Circle | *Square): proves scratch allocation
// freshness for pointer members.
type PtrShape interface {
	*Circle | *Square
}

type PtrShapeHolder struct {
	Item PtrShape `json:"item"`
}

// Pointer field union: verifies scratch allocation isolation for struct fields.
type PtrMemberA struct {
	Val *int64 `json:"val"`
	Tag string `json:"tag"`
}

type PtrMemberB struct {
	Val   *int64 `json:"val"`
	Other string `json:"other"`
}

type PtrUnion interface {
	PtrMemberA | PtrMemberB
}

type PtrHolder struct {
	Item PtrUnion `json:"item"`
}

// Union member with an unmodeled field (map[string]string falls back to reflection).
type FallbackMember struct {
	Name string            `json:"name"`
	Data map[string]string `json:"data"`
}

type FallbackUnion interface {
	Circle | FallbackMember
}

type FallbackHolder struct {
	Item FallbackUnion `json:"item"`
}

func mustMarshal(t *testing.T, v any) []byte {
	t.Helper()
	b, err := json.Marshal(v)
	if err != nil {
		panic(err)
	}
	return b
}

func mustUnmarshal(t *testing.T, data []byte, dst any) {
	t.Helper()
	if err := json.Unmarshal(data, dst); err != nil {
		panic(err)
	}
}

// TestUnionMarshal verifies S1: a closed-union value marshals to its dynamic
// member's static bytes, matching both the member's MarshalJSON and reflective oracle.
func TestUnionMarshal(t *testing.T) {
	var v Shape = Circle{R: 3}
	gotTop := mustMarshal(t, v)
	wantCircle, err := Circle{R: 3}.MarshalJSON()
	if err != nil {
		panic(err)
	}
	if !bytes.Equal(gotTop, wantCircle) {
		t.Fatalf("top-level union marshal %s != Circle.MarshalJSON %s", gotTop, wantCircle)
		return
	}
	oracleCircle := mustMarshal(t, CircleMirror{R: 3})
	if !bytes.Equal(gotTop, oracleCircle) {
		t.Fatalf("top-level union marshal %s != reflective oracle %s", gotTop, oracleCircle)
		return
	}

	hCircle := ShapeHolder{Item: Circle{R: 3}}
	gotHolder := mustMarshal(t, hCircle)
	wantHolder := `{"item":{"r":3}}`
	if string(gotHolder) != wantHolder {
		t.Fatalf("ShapeHolder(Circle) got %s, want %s", gotHolder, wantHolder)
		return
	}

	hSquare := ShapeHolder{Item: Square{S: 5}}
	gotSquare := mustMarshal(t, hSquare)
	wantSquare := `{"item":{"s":5}}`
	if string(gotSquare) != wantSquare {
		t.Fatalf("ShapeHolder(Square) got %s, want %s", gotSquare, wantSquare)
		return
	}
}

// TestUnionTrialOrder verifies S4: unmarshal tries members in declaration order,
// and a document accepted by exactly one member is assigned.
func TestUnionTrialOrder(t *testing.T) {
	var hSquare ShapeHolder
	mustUnmarshal(t, []byte(`{"item":{"s":7}}`), &hSquare)
	sq, ok := hSquare.Item.(Square)
	if !ok {
		t.Fatalf("expected Square, got %T: %#v", hSquare.Item, hSquare.Item)
	}
	if sq.S != 7 {
		t.Fatalf("expected Square.S = 7, got %d", sq.S)
	}

	var hCircle ShapeHolder
	mustUnmarshal(t, []byte(`{"item":{"r":11}}`), &hCircle)
	ci, ok := hCircle.Item.(Circle)
	if !ok {
		t.Fatalf("expected Circle, got %T: %#v", hCircle.Item, hCircle.Item)
	}
	if ci.R != 11 {
		t.Fatalf("expected Circle.R = 11, got %d", ci.R)
	}
	// SPEC sec 12.2: unknown fields are ignored. An extra unknown key must not
	// reject the otherwise-matching member — {"s":7,"extra":true} is Square.
	var hSquareExtra ShapeHolder
	mustUnmarshal(t, []byte(`{"item":{"s":7,"extra":true}}`), &hSquareExtra)
	sqX, ok := hSquareExtra.Item.(Square)
	if !ok {
		t.Fatalf("expected Square with unknown field ignored, got %T: %#v", hSquareExtra.Item, hSquareExtra.Item)
	}
	if sqX.S != 7 {
		t.Fatalf("expected Square.S = 7, got %d", sqX.S)
	}
}

// TestUnionAmbiguityError verifies S6: overlapping documents accepted by multiple
// members return an ambiguity error naming the union and member names.
func TestUnionAmbiguityError(t *testing.T) {
	var oh OverlapHolder
	err := json.Unmarshal([]byte(`{"item":{"id":1}}`), &oh)
	if err == nil {
		t.Fatal("expected ambiguity error, got nil")
		return
	}

	if _, ok := err.(rt.MissingFieldError); ok {
		t.Fatalf("ambiguity error must not be MissingFieldError: %v", err)
		return
	}

	msg := err.Error()
	if !strings.Contains(msg, "OverlapUnion") {
		t.Fatalf("ambiguity error %q must name union OverlapUnion", msg)
		return
	}
	if !strings.Contains(msg, "Alpha") || !strings.Contains(msg, "Beta") {
		t.Fatalf("ambiguity error %q must name members Alpha and Beta", msg)
		return
	}

	var trialErr rt.UnionTrialError
	if !errors.As(err, &trialErr) {
		t.Fatalf("expected rt.UnionTrialError, got %T: %v", err, err)
		return
	}
	if trialErr.Matched <= 1 {
		t.Fatalf("expected Matched > 1, got %d", trialErr.Matched)
		return
	}
}

// TestUnionFailedTrialsLeaveTargetUntouched verifies S5 and S7: pre-filled
// destinations remain byte-identical after failed trials (ambiguous or 0-match).
func TestUnionFailedTrialsLeaveTargetUntouched(t *testing.T) {
	oh := OverlapHolder{Item: Alpha{ID: 42}}
	err := json.Unmarshal([]byte(`{"item":{"id":1}}`), &oh)
	if err == nil {
		t.Fatal("expected ambiguity error, got nil")
		return
	}
	a, ok := oh.Item.(Alpha)
	if !ok || a.ID != 42 {
		t.Fatalf("target was modified after ambiguous trial: %#v", oh.Item)
		return
	}

	sh := ShapeHolder{Item: Circle{R: 99}}
	err = json.Unmarshal([]byte(`{"item":{"unrecognized_field":999}}`), &sh)
	if err == nil {
		t.Fatal("expected failure on unrecognized document, got nil")
		return
	}
	c, ok := sh.Item.(Circle)
	if !ok || c.R != 99 {
		t.Fatalf("target was modified after failed trial: %#v", sh.Item)
		return
	}
}

// TestUnionPointerMembersFresh verifies S5/S7 for pointer-term members:
// failed trials leave pre-filled pointer target untouched, and successful
// trials allocate fresh pointer members.
func TestUnionPointerMembersFresh(t *testing.T) {
	cOrig := Circle{R: 50}
	psh := PtrShapeHolder{Item: &cOrig}

	err := json.Unmarshal([]byte(`{"item":{"unrecognized":999}}`), &psh)
	if err == nil {
		t.Fatal("expected trial error on unrecognized document, got nil")
		return
	}
	if psh.Item != &cOrig || psh.Item.(*Circle).R != 50 {
		t.Fatalf("target was corrupted by failed trial: %#v", psh.Item)
		return
	}

	mustUnmarshal(t, []byte(`{"item":{"s":88}}`), &psh)
	sq, ok := psh.Item.(*Square)
	if !ok {
		t.Fatalf("expected *Square, got %T", psh.Item)
		return
	}
	if sq.S != 88 {
		t.Fatalf("expected Square.S = 88, got %d", sq.S)
		return
	}
}

// TestUnionPointerFieldsFresh verifies S5/S7 for struct members with pointer fields:
// failed trials do not mutate pointees, and successful trials allocate fresh pointers.
func TestUnionPointerFieldsFresh(t *testing.T) {
	var origVal int64 = 100
	ph := PtrHolder{Item: PtrMemberA{Val: &origVal, Tag: "orig"}}

	err := json.Unmarshal([]byte(`{"item":{"val":999,"tag":"bad","other":"bad"}}`), &ph)
	if err == nil {
		t.Fatal("expected trial error, got nil")
		return
	}
	if origVal != 100 {
		t.Fatalf("pointee was modified by failed trial: origVal = %d, want 100", origVal)
		return
	}
	memA, ok := ph.Item.(PtrMemberA)
	if !ok || *memA.Val != 100 || memA.Tag != "orig" {
		t.Fatalf("target was corrupted: %#v", ph.Item)
		return
	}

	mustUnmarshal(t, []byte(`{"item":{"val":42,"tag":"ok"}}`), &ph)
	memSuccess, ok := ph.Item.(PtrMemberA)
	if !ok {
		t.Fatalf("expected PtrMemberA, got %T", ph.Item)
		return
	}
	if *memSuccess.Val != 42 {
		t.Fatalf("expected fresh val 42, got %d", *memSuccess.Val)
		return
	}
	if memSuccess.Val == &origVal {
		t.Fatal("scratch decode must not reuse target pointer allocation")
		return
	}
}

// TestUnionFallbackMemberRoundTrip verifies that a union member with an
// unmodeled field round-trips through its per-field reflective fallback.
func TestUnionFallbackMemberRoundTrip(t *testing.T) {
	fh := FallbackHolder{
		Item: FallbackMember{
			Name: "meta",
			Data: map[string]string{"env": "prod", "zone": "us-east"},
		},
	}
	data := mustMarshal(t, fh)
	var fh2 FallbackHolder
	mustUnmarshal(t, data, &fh2)
	if !reflect.DeepEqual(fh, fh2) {
		t.Fatalf("fallback member round-trip mismatch:\ngot:  %#v\nwant: %#v", fh2, fh)
	}
}

// TestUnionNullLeavesFieldAbsent verifies that JSON null leaves a union field absent (nil).
func TestUnionNullLeavesFieldAbsent(t *testing.T) {
	sh := ShapeHolder{Item: Circle{R: 12}}
	mustUnmarshal(t, []byte(`{"item":null}`), &sh)
	if sh.Item != nil {
		t.Fatalf("expected nil union field after null, got %#v", sh.Item)
	}
}
