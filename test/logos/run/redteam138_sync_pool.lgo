// run -goexperiment logosarena

package main

import (
	"fmt"
	"sync"
)

// REDTEAM #138 (SPEC Sec 8.3, T-301.1; IMPLEMENTATION.md M18-S3): a value
// stored into sync.Pool must stay on the heap; the compiler must keep such
// values out of the arena. r138Put builds a dynamic byte slice (a shape the
// arena would otherwise take) and stores it in the pool. The noinline keeps
// the make in the callee frame, so an arena misplacement pops with the
// frame and the retrieved contents corrupt. No GC runs between Put and Get
// because sync.Pool may drop entries at collection; the frame exit alone
// exposes the bug. Value-only: an all-heap placement passes; only an
// arena-placed pool entry fails. This fixture is the #138 close-out probe.

//go:noinline
func r138Put(p *sync.Pool, n int) {
	s := make([]byte, n)
	for i := range s {
		s[i] = byte(i + 1)
	}
	p.Put(s)
}

// Arena-eligible scratch consumed without escaping: after r138Put returns,
// its frame region is popped, so this reuse clobbers any wrongly
// arena-placed pool bytes before Get reads them. Without this write the
// popped memory could still hold stale bytes and the sum below would pass
// on a misplacement. Worst case this helper goes to the heap and the check
// below is exactly as strong as before; it cannot fail on its own.

//go:noinline
func r138Consume(b []byte) int {
	if len(b) == 0 {
		return 0
	}
	return len(b) + int(b[0])
}

//go:noinline
func r138Clobber(n int) int {
	tmp := make([]byte, n)
	for i := range tmp {
		tmp[i] = 0
	}
	return r138Consume(tmp)
}

func main() {
	var p sync.Pool
	r138Put(&p, 64)
	if r138Clobber(64) != 64 {
		panic("redteam138: clobber helper broken")
	}
	got, ok := p.Get().([]byte)
	if !ok {
		panic("redteam138: pool lost stored slice")
	}
	if len(got) != 64 {
		panic("redteam138: bad length")
	}
	sum := 0
	for _, b := range got {
		sum += int(b)
	}
	fmt.Println("pool:", len(got), sum)
	if sum != 2080 {
		panic("redteam138: pooled slice corrupted")
	}
}
