// run -O=3

package main

import "fmt"

// M13-S3 clone-alias suppression (SPEC T-203.4): Take reads cs[0], then
// replaces plain[0], then reads cs[0] again. The const-slice lowering
// copies the const argument (rt.CovSlice), so the second read still sees
// "orc". A no-copy clone would share the backing with plain and print
// "orc,ogre". The specializer keeps the snapshot wherever the CovSlice
// operand may alias another channel: the same slice passed twice, two
// package-level variables bound to one backing, and a package-level
// variable sharing its backing with a local. Every case below prints
// orc,orc at -O=1 (specialize_alias_o1.lgo runs this body there) and at
// -O=3. There is no Go twin: const views are loGo/s syntax.

type Creature interface {
	const Name() string
}

type Monster struct{ name string }

func (m *Monster) Name() string { return m.name }

func Take(cs const []Creature, plain []*Monster) string {
	before := cs[0].Name()
	plain[0] = &Monster{"ogre"}
	return before + "," + cs[0].Name()
}

var (
	backing = []*Monster{{name: "orc"}}
	ag      = backing
	bg      = backing
	g       = []*Monster{{name: "orc"}}
)

func main() {
	ms := []*Monster{{name: "orc"}}
	fmt.Println(Take(ms, ms))

	fmt.Println(Take(ag, bg))

	local := g
	fmt.Println(Take(g, local))
}
