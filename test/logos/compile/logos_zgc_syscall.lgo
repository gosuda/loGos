// run -goexperiment logosgcmoving -gcflags=all=-lb "-ldflags=-X runtime.logosGCMode=zgc"

package main

import (
	"context"
	"errors"
	"fmt"
	"runtime"
	"sync/atomic"
	"syscall"
	"unsafe"
)

// Moving-GC syscall foreign-admission behavioral attack (compiler half).
//
// Exercises every caller-side form the order-time emission must cover
// using the public syscall surface: direct static calls, the imported
// zsyscall wrapper, a tiny inlinable wrapper, a deferred direct call, a
// reassigned function value, go group children (call and block), scalar
// and errno-ABI controls, and a blocking-read relocation race against a
// fragmented heap.
// Silent on success (the harness expects empty output without a .out
// file); panics on the first mismatch.
//
// Old/fixed difference: the roundtrip, control, and single-pointer storm
// sections pass on any collector and pin the ABI admission must preserve.
// The single-pointer storm is a control, not the red: the blocked
// goroutine's own frame holds the buffer pointer, and selection-time
// conservative scanning of a syscall-blocked stack already keeps that
// page in place. The iovec storm is the red: its payload is reachable only
// through a heap iovec array, so no word of the blocked frame names it, the
// page is selected for evacuation, and the kernel keeps writing to the
// address it captured at syscall entry. It fails on a moving collector
// without admission and passes with a complete closure. The zgc mode comes
// from the directive ldflags above; the harness must forward these flags.
// A rejected flag is a harness failure. The attack must never run under a
// nonmoving collector as a substitute for the selected moving mode. The
// all= load-barrier flag mirrors what -gc=zgc passes the compiler for
// every package.
//
// Structure: every goroutine is a child of a go group. The storm needs no
// stop flag or channel: one child runs a fixed count of full collections
// after the reader's first attempt and then writes the canary; the reader
// child is the only consumer; the group joins both.

const (
	msgText      = "moving-gc-syscall-foreign-roots"
	groupSize    = 20000
	keepEvery    = 10
	slotBytes    = 64
	inBlockCycle = 10
)

var (
	msg       = []byte(msgText)
	sinkSlot  *slot?
	sinkBytes []byte
)

// slot is a pointer-bearing heap object whose interior byte array is the
// kernel target of the scan-object storm.
type slot struct {
	next *slot?
	data [56]byte
}

// storm carries the reader's first-attempt signal to the collecting child.
type storm struct {
	attempts atomic.Uint64
}

func fail(what string) error {
	return errors.New("logos_zgc_syscall: " + what)
}

func report(name string, err error) {
	if err != nil {
		panic(fmt.Sprintf("logos_zgc_syscall: %s: %v", name, err))
	}
}

func closeQuiet(fd int) {
	if err := syscall.Close(fd); err != nil {
		panic(err)
	}
}

func openPipe() (rfd, wfd int, err error) {
	var p [2]int
	if err = syscall.Pipe(p[:]); err != nil {
		return 0, 0, err
	}
	return p[0], p[1], nil
}

func writeAll(fd int, data []byte) error {
	sent := 0
	for sent < len(data) {
		n, err := syscall.Write(fd, data[sent:])
		if err != nil {
			return err
		}
		if n == 0 {
			return fail("write made no progress")
		}
		sent += n
	}
	return nil
}

func errnoErr(e syscall.Errno) error {
	if e != 0 {
		return e
	}
	return nil
}

func finishRead(n uintptr, errno syscall.Errno, want int) error {
	if errno != 0 {
		return errno
	}
	if int(n) != want {
		return fail("short read")
	}
	return nil
}

func canaryByte(i int) byte {
	return byte(i%250) + 1
}

func canary(n int) []byte {
	b := make([]byte, n)
	for i := range b {
		b[i] = canaryByte(i)
	}
	return b
}

func compareCanary(buf []byte) error {
	for i := range buf {
		if buf[i] != canaryByte(i) {
			return fmt.Errorf("storm corruption at byte %d: got %d want %d", i, buf[i], canaryByte(i))
		}
	}
	return nil
}

// syscallFor returns a reassigned function value: the callee is not
// static at the call sites below. A nonempty buffer selects the trapping
// entry, the only one that lets a blocked read overlap a collection.
func syscallFor(buf []byte) func(trap, a1, a2, a3 uintptr) (uintptr, uintptr, syscall.Errno) {
	f := syscall.RawSyscall
	if len(buf) > 0 {
		f = syscall.Syscall
	}
	return f
}

func wrapperRead(fd uintptr, p unsafe.Pointer, n uintptr) (uintptr, syscall.Errno) {
	r1, _, errno := syscall.Syscall(syscall.SYS_READ, fd, uintptr(p), n)
	return r1, errno
}

func readDirect(fd int, buf []byte) error {
	p := unsafe.Pointer(&buf[0])
	n, _, errno := syscall.Syscall(syscall.SYS_READ, uintptr(fd), uintptr(p), uintptr(len(buf)))
	return finishRead(n, errno, len(buf))
}

func readInlined(fd int, buf []byte) error {
	n, errno := wrapperRead(uintptr(fd), unsafe.Pointer(&buf[0]), uintptr(len(buf)))
	return finishRead(n, errno, len(buf))
}

func readImported(fd int, buf []byte) error {
	n, err := syscall.Read(fd, buf)
	if err != nil {
		return err
	}
	if n != len(buf) {
		return fail("imported short read")
	}
	return nil
}

func readFuncValue(fd int, buf []byte) error {
	f := syscallFor(buf)
	p := unsafe.Pointer(&buf[0])
	n, _, errno := f(syscall.SYS_READ, uintptr(fd), uintptr(p), uintptr(len(buf)))
	return finishRead(n, errno, len(buf))
}

// readDeferred performs the read at function exit: the deferred call's
// pointer operand is evaluated at the defer statement.
func readDeferred(fd int, buf []byte) error {
	p := unsafe.Pointer(&buf[0])
	defer syscall.Syscall(syscall.SYS_READ, uintptr(fd), uintptr(p), uintptr(len(buf)))
	return nil
}

func readGroupChild(fd int, buf []byte) error {
	ctx := context.Background()
	go group (ctx) {
		go readDirect(fd, buf)
	}
	return nil
}

func readGroupBlock(fd int, buf []byte) error {
	ctx := context.Background()
	go group (ctx) {
		go {
			p := unsafe.Pointer(&buf[0])
			n, _, errno := syscall.Syscall(syscall.SYS_READ, uintptr(fd), uintptr(p), uintptr(len(buf)))
			finishRead(n, errno, len(buf))?
		}
	}
	return nil
}

// roundtrip writes msg into a fresh pipe, runs read on the read end, and
// compares the bytes it filled in.
func roundtrip(read func(fd int, buf []byte) error) error {
	rfd, wfd, err := openPipe()
	if err != nil {
		return err
	}
	if werr := writeAll(wfd, msg); werr != nil {
		return errors.Join(werr, syscall.Close(rfd), syscall.Close(wfd))
	}
	buf := make([]byte, len(msg))
	rerr := read(rfd, buf)
	cerr := errors.Join(syscall.Close(rfd), syscall.Close(wfd))
	if jerr := errors.Join(rerr, cerr); jerr != nil {
		return jerr
	}
	if string(buf) != string(msg) {
		return fail("roundtrip data mismatch")
	}
	return nil
}

// scalarControls pins scalar bit identity and the errno result ABI across
// the direct, reassigned, and raw forms.
func scalarControls() error {
	pid, _, errno := syscall.Syscall(syscall.SYS_GETPID, 0, 0, 0)
	if errno != 0 || pid == 0 {
		return fail("direct getpid")
	}
	f := syscallFor(msg)
	viaValue, _, errno := f(syscall.SYS_GETPID, 0, 0, 0)
	raw, _, _ := syscall.RawSyscall(syscall.SYS_GETPID, 0, 0, 0)
	if errno != 0 || viaValue != pid || raw != pid {
		return fail("scalar pid identity")
	}
	_, _, bad := syscall.Syscall(syscall.SYS_READ, ^uintptr(0), 0, 0)
	if bad != syscall.EBADF {
		return fail("errno ABI")
	}
	return nil
}

func fragmentSlots() []*slot {
	dense := make([](*slot?), groupSize)
	for i := range dense {
		dense[i] = &slot{}
	}
	for i := range dense {
		if i%5 >= 3 {
			dense[i] = nil
		}
	}
	sparse := make([]*slot, 0, groupSize/keepEvery)
	for i := range groupSize {
		s := &slot{}
		if i%keepEvery == 0 {
			sparse = append(sparse, s)
		}
	}
	sinkSlot = dense[0]
	return sparse
}

func fragmentBytes() [][]byte {
	dense := make([][]byte, groupSize)
	for i := range dense {
		dense[i] = make([]byte, slotBytes)
	}
	for i := range dense {
		if i%5 >= 3 {
			dense[i] = nil
		}
	}
	sparse := make([][]byte, 0, groupSize/keepEvery)
	for i := range groupSize {
		b := make([]byte, slotBytes)
		if i%keepEvery == 0 {
			sparse = append(sparse, b)
		}
	}
	sinkBytes = dense[0]
	return sparse
}

// targetBuf returns a kernel buffer that survives in a fragmented page,
// the shape a relocating collector evacuates, plus the holder that keeps
// its neighbors alive. Kind 0 is the interior of a pointer-bearing object;
// kind 1 is a pointer-free backing.
func targetBuf(kind int) ([]byte, any) {
	if kind == 0 {
		sparse := fragmentSlots()
		t := sparse[len(sparse)/2]
		return t.data[:], sparse
	}
	sparse := fragmentBytes()
	return sparse[len(sparse)/2], sparse
}

// stormReader blocks in a direct Syscall read of buf. Its first statement
// signals the collecting child; the trap follows within nanoseconds, so
// every collection counted afterwards runs while the read is blocked.
func stormReader(s *storm, fd int, buf []byte) error {
	s.attempts.Add(1)
	p := unsafe.Pointer(&buf[0])
	n, _, errno := syscall.Syscall(syscall.SYS_READ, uintptr(fd), uintptr(p), uintptr(len(buf)))
	if err := finishRead(n, errno, len(buf)); err != nil {
		return err
	}
	return compareCanary(buf)
}

// stormGC waits for the reader's first attempt, runs a fixed count of full
// collections, then writes the canary. The deferred close of the write end
// wakes the reader with end of file if anything fails before the write.
func stormGC(s *storm, wfd int, size int) error {
	defer closeQuiet(wfd)
	for s.attempts.Load() == 0 {
		runtime.Gosched()
	}
	for range inBlockCycle {
		runtime.GC()
	}
	return writeAll(wfd, canary(size))
}

func stormRound(ctx context.Context, kind int) error {
	rfd, wfd, err := openPipe()
	if err != nil {
		return err
	}
	defer closeQuiet(rfd)
	buf, keep := targetBuf(kind)
	s := &storm{}
	go group (ctx) {
		go stormReader(s, rfd, buf)
		go stormGC(s, wfd, len(buf))
	}
	runtime.KeepAlive(keep)
	return nil
}

// stormIovReader blocks in a direct Syscall readv. Its frame holds only
// the pointer to the iovec array, never the payload the iovec names, so a
// conservative scan of this syscall-blocked stack cannot pin the payload.
// The caller verifies the payload after the group joins.
func stormIovReader(s *storm, fd int, iov []syscall.Iovec, want int) error {
	s.attempts.Add(1)
	p := unsafe.Pointer(&iov[0])
	n, _, errno := syscall.Syscall(syscall.SYS_READV, uintptr(fd), uintptr(p), uintptr(len(iov)))
	return finishRead(n, errno, want)
}

// stormIovRound is the red storm: the fragmented payload is reachable
// only through the heap iovec the blocked reader hands the kernel. The
// parent goroutine, which is not blocked in a system call, is the only
// frame that names the payload and is scanned precisely.
func stormIovRound(ctx context.Context, kind int) error {
	rfd, wfd, err := openPipe()
	if err != nil {
		return err
	}
	defer closeQuiet(rfd)
	buf, keep := targetBuf(kind)
	iov := make([]syscall.Iovec, 1)
	iov[0].Base = &buf[0]
	iov[0].SetLen(len(buf))
	s := &storm{}
	go group (ctx) {
		go stormIovReader(s, rfd, iov, len(buf))
		go stormGC(s, wfd, len(buf))
	}
	runtime.KeepAlive(keep)
	return compareCanary(buf)
}

func main() {
	ctx := context.Background()
	report("scalar controls", scalarControls())
	report("direct", roundtrip(readDirect))
	report("inlined wrapper", roundtrip(readInlined))
	report("imported wrapper", roundtrip(readImported))
	report("function value", roundtrip(readFuncValue))
	report("deferred direct", roundtrip(readDeferred))
	report("group child call", roundtrip(readGroupChild))
	report("group child block", roundtrip(readGroupBlock))
	report("control storm scan interior", stormRound(ctx, 0))
	report("control storm pointer-free", stormRound(ctx, 1))
	report("iovec storm scan interior", stormIovRound(ctx, 0))
	report("iovec storm pointer-free", stormIovRound(ctx, 1))
}
