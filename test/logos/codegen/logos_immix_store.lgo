// asmcheck -goexperiment logosgcmoving

package main

// M19-S8 attack: a heap pointer store is routed through the immix line-mark
// helper ahead of the store, adjacent pointer fields of one object share one
// call that covers both, a field that is not adjacent gets its own call, and
// no store reaches a card-mark barrier. The generational card table is set by
// the write barrier flush (runtime.logosGenFlushCards), never by code the
// compiler emits at the store, so the negative checks name the card helpers
// the experiment could call and a plain "cardMark" call.
type immixStoreNode struct {
	value *immixStoreNode?
}

// immixStorePair holds two adjacent pointer fields: the stores to them form
// one contiguous range and take one line-mark call.
type immixStorePair struct {
	first  *immixStoreNode?
	second *immixStoreNode?
}

// immixStoreSplit holds a word between its pointer fields, so the second
// store does not continue the range of the first.
type immixStoreSplit struct {
	first  *immixStoreNode?
	count  int
	second *immixStoreNode?
}

//go:noinline
func immixHeapPointerStore(dst *immixStoreNode, value *immixStoreNode) {
	// amd64:1"CALL.*runtime\\.logosImmixStoreBarrier"
	// amd64:-"CALL.*cardMark"
	// amd64:-"CALL.*runtime\\.logosGen"
	// arm64:1"CALL.*runtime\\.logosImmixStoreBarrier"
	// arm64:-"CALL.*cardMark"
	// arm64:-"CALL.*runtime\\.logosGen"
	dst.value = value
}

//go:noinline
func immixAdjacentStores(dst *immixStorePair, a *immixStoreNode, b *immixStoreNode) {
	// amd64:1"CALL.*runtime\\.logosImmixStoreBarrier"
	// amd64:-"CALL.*cardMark"
	// arm64:1"CALL.*runtime\\.logosImmixStoreBarrier"
	// arm64:-"CALL.*cardMark"
	dst.first = a
	// amd64:-"CALL.*runtime\\.logosImmixStoreBarrier"
	// amd64:-"CALL.*cardMark"
	// arm64:-"CALL.*runtime\\.logosImmixStoreBarrier"
	// arm64:-"CALL.*cardMark"
	dst.second = b
}

//go:noinline
func immixSplitStores(dst *immixStoreSplit, a *immixStoreNode, b *immixStoreNode) {
	// amd64:1"CALL.*runtime\\.logosImmixStoreBarrier"
	// arm64:1"CALL.*runtime\\.logosImmixStoreBarrier"
	dst.first = a
	dst.count = 1
	// amd64:1"CALL.*runtime\\.logosImmixStoreBarrier"
	// amd64:-"CALL.*cardMark"
	// arm64:1"CALL.*runtime\\.logosImmixStoreBarrier"
	// arm64:-"CALL.*cardMark"
	dst.second = b
}

var (
	immixStoreSink immixStoreNode
	immixPairSink  immixStorePair
	immixSplitSink immixStoreSplit
)

func main() {
	immixHeapPointerStore(&immixStoreSink, &immixStoreSink)
	immixAdjacentStores(&immixPairSink, &immixStoreSink, &immixStoreSink)
	immixSplitStores(&immixSplitSink, &immixStoreSink, &immixStoreSink)
}
