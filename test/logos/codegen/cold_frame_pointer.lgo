// asmcheck -O=2

package main

import (
	"errors"
	"fmt"
	"os"
)

// #104: asmcheck cold blocks keep PUSHQ BP, MOVQ SP, BP inside the function.

func fail() (int, error) {
	return 0, errors.New("boom")
}

// amd64:"PUSHQ BP" "MOVQ SP, BP"
func divide() (int, error) {
	v := fail()? // amd64:-"MOVQ.*, BP"
	return v, nil
}

// amd64:"PUSHQ BP" "MOVQ SP, BP"
func check(n int) int {
	if n < 0 {
		os.Exit(1) // amd64:-"MOVQ.*, BP"
	}
	return n
}

func main() {
	v, err := divide()
	fmt.Println(v, err)
	fmt.Println(check(3))
}
