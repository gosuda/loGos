// asmcheck -O=3

package main

// M13-S3 row #121 (SPEC T-203.4): at -O=3 the call Names(ms) with a
// []*Monster argument specializes to a clone whose parameter is the plain
// []*Monster, so the call site passes ms as it is: no CovSlice conversion
// call, no allocation, no copy loop, and the method call inside the clone is
// a static call to (*Monster).Name. The original Names keeps its interface
// calls on the same source line, so that check is positive only. recover
// keeps Names out of the inliner. There is no Go twin: const views are
// loGo/s syntax (test/logos/run/specialize_constslice.lgo proves the output).

type Creature interface {
	const Name() string
}

type Monster struct{ name string }

//go:noinline
func (m *Monster) Name() string { return m.name }

func Names(cs const []Creature) int {
	_ = recover()
	total := 0
	for _, c := range cs {
		total += len(c.Name()) // amd64:`CALL.*\(\*Monster\)\.Name` arm64:`CALL.*\(\*Monster\)\.Name`
	}
	return total
}

func main() {
	ms := []*Monster{{name: "orc"}, {name: "imp"}}
	println(Names(ms)) // amd64:`CALL.*Names.logosspec[0-9]+` amd64:-`CALL.*CovSlice` amd64:-`CALL.*runtime\.(makeslice|newobject|growslice)` arm64:`CALL.*Names.logosspec[0-9]+` arm64:-`CALL.*CovSlice` arm64:-`CALL.*runtime\.(makeslice|newobject|growslice)`
}
