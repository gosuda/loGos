// asmcheck -O=3

package main

// REDTEAM #15 (SPEC Sec 2.3, T-203.4; IMPLEMENTATION.md M13-S3): a call
// site observing more than 4 concrete types must not specialize. The
// single nested call inside an outer function cloned for five concrete
// types observes five type vectors, exceeding specMaxCallSiteTypes, so it
// keeps the interface call and the inner function gains no clone. The
// sibling nest cloned for four stays eligible and the inner call folds to
// a clone. One parameter per function keeps complexity::cognitive_overflow
// silent. recover keeps callees out of the inliner so the calls stay
// visible, following specialize_depth.lgo and TestSpecializeCallSiteCap.
// Distinct from the id/id4 run behavior in specialize.lgo, which covers
// independent single-type sites rather than the nested cap.

type w15er interface{ W15() int }

type w15a struct{}
type w15b struct{}
type w15c struct{}
type w15d struct{}
type w15e struct{}

func (w15a) W15() int { return 1 }
func (w15b) W15() int { return 2 }
func (w15c) W15() int { return 3 }
func (w15d) W15() int { return 4 }
func (w15e) W15() int { return 5 }

func w15Inner5(w w15er) int {
	_ = recover()
	return w.W15()
}

func w15Outer5(w w15er) int {
	_ = recover()
	return w15Inner5(w) // amd64:`CALL.*w15Inner5\(SB\)` amd64:-`CALL.*w15Inner5.logosspec` arm64:`CALL.*w15Inner5\(SB\)` arm64:-`CALL.*w15Inner5.logosspec`
}

func w15Inner4(w w15er) int {
	_ = recover()
	return w.W15()
}

func w15Outer4(w w15er) int {
	_ = recover()
	return w15Inner4(w) // amd64:`CALL.*w15Inner4.logosspec[0-9]+` arm64:`CALL.*w15Inner4.logosspec[0-9]+`
}

func main() {
	println(w15Outer5(w15a{}) + w15Outer5(w15b{}) + w15Outer5(w15c{}) + w15Outer5(w15d{}) + w15Outer5(w15e{}))
	println(w15Outer4(w15a{}) + w15Outer4(w15b{}) + w15Outer4(w15c{}) + w15Outer4(w15d{}))
}
