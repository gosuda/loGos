// asmcheck -goexperiment logosarena

package main

// REDTEAM #155 (IMPLEMENTATION.md M18-S3, T-301.1): SIGURG arriving
// mid-bump double allocating address. The noscan fast path MUST be an
// inline add-compare sequence with a slow-path call. The sequence MUST be
// marked as an async-preemption unsafe point. A preemption landing inside
// the half-updated chunk watermark would observe a torn bump and hand out
// the same address twice, so the op carries UnsafePoint and the emitter
// brackets it between a PCDATA unsafe marker (-2) and the next safe
// marker (-1). This fixture pins that bracketing on a 512-byte noscan
// make (exactly at the 512 threshold, so it takes the inline sequence)
// plus a 513-byte slow-path control with no inline sequence and no unsafe
// marker. Only amd64 lowers makes to the arena, so only amd64 is checked.
// Distinct from the 511/512/513 threshold probes in arena_bump.lgo, which
// pin the size boundary; this file pins the preemption-safety bracketing.

var r155Sink int

//go:noinline
func r155Use(b []byte) int {
	if len(b) == 0 {
		return 0
	}
	b[0] = 1
	return len(b) + int(b[0])
}

// The payload exactly at the threshold takes the inline sequence with the
// unsafe-point bracketing and a slow-path call on overflow.
//
//go:noinline
func r155Inline512() int {
	// amd64:"LEAQ 7\\("
	// amd64:"ANDQ \\$-8,"
	// amd64:"LEAQ 512\\("
	// amd64:"CMPQ .*24\\("
	// amd64:"JHI"
	// amd64:"MOVQ 16\\("
	// amd64:"MOVQ .*, 16\\("
	// amd64:"PCDATA \\$0, \\$-2"
	// amd64:"PCDATA \\$0, \\$-1"
	// amd64:1"CALL.*runtime\\.logosArenaAlloc"
	// amd64:-"CALL.*runtime\\.logosArenaBump"
	// amd64:-"CALL.*runtime\\.logosArenaMakeSlice"
	// amd64:-"CALL.*runtime\\.makeslice"
	used := r155Use(make([]byte, 512))
	return used
}

// One byte over the threshold takes the slow call alone with no inline
// sequence and no unsafe marker.
//
//go:noinline
func r155Slow513() int {
	// amd64:1"CALL.*runtime\\.logosArenaAlloc"
	// amd64:-"CALL.*runtime\\.logosArenaBump"
	// amd64:-"CALL.*runtime\\.logosArenaMakeSlice"
	// amd64:-"CALL.*runtime\\.makeslice"
	// amd64:-"ANDQ \\$-8,"
	// amd64:-"PCDATA \\$0, \\$-2"
	used := r155Use(make([]byte, 513))
	return used
}

func main() {
	r155Sink += r155Inline512()
	r155Sink += r155Slow513()
}
