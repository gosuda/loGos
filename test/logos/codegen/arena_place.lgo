// asmcheck -goexperiment logosarena

package main

import "sync"

// M18-S2 attack (IMPLEMENTATION.md M18-S2). A non-escaping make of noscan
// elements with a dynamic size lowers to runtime.logosArenaMakeSlice, the
// helper that applies the makeslice size verdicts and then allocates in the
// arena region, instead of runtime.makeslice. A make whose backing array
// escapes stays on the heap through runtime.makeslice: a store into a global,
// and a buffer handed to sync.Pool.Put, which keeps it past the frame.
//
// Each make sits on its own source line and the asmcheck match is per source
// line, so every positive and negative check names one site. Every arena make
// is consumed by a noinline helper that does not let its argument escape, so
// the allocation is neither dropped nor forced to the heap by the consumer.
// A returned make takes a caller-region path with its own consent token and
// is left out here on purpose: the controls use a global store and a real
// pool so the heap verdict is unambiguous. The lowering to the arena exists
// on amd64 only, so arm64 is checked for the absence of the helper.

var (
	placeSink  []byte
	placeTotal int
	placePool  sync.Pool
)

//go:noinline
func placeConsume(b []byte) int {
	if len(b) == 0 {
		return 0
	}
	b[0] = 1
	return len(b) + cap(b) + int(b[0])
}

//go:noinline
func placeConsumeWords(w []uint64) int {
	if len(w) == 0 {
		return 0
	}
	w[0] = 1
	return len(w) + cap(w) + int(w[0])
}

//go:noinline
func placeDynamic(n int) int {
	// amd64:1"CALL.*runtime\\.logosArenaMakeSlice"
	// amd64:-"CALL.*runtime\\.makeslice"
	// arm64:-"CALL.*runtime\\.logosArenaMakeSlice"
	b := make([]byte, n)
	return placeConsume(b)
}

// A separate capacity still goes through the one helper, which takes both
// the length and the capacity.
//
//go:noinline
func placeDynamicCap(n int) int {
	// amd64:1"CALL.*runtime\\.logosArenaMakeSlice"
	// amd64:-"CALL.*runtime\\.makeslice"
	words := make([]uint64, n, n+8)
	return placeConsumeWords(words)
}

//go:noinline
func placeGlobalStore(n int) int {
	// amd64:1"CALL.*runtime\\.makeslice"
	// amd64:-"CALL.*runtime\\.logosArenaMakeSlice"
	b := make([]byte, n)
	placeSink = b
	return len(b)
}

//go:noinline
func placePoolPut(n int) int {
	// amd64:1"CALL.*runtime\\.makeslice"
	// amd64:-"CALL.*runtime\\.logosArenaMakeSlice"
	buf := make([]byte, n)
	placePool.Put(buf)
	return len(buf)
}

// The usual pool shape: reuse a pooled buffer when it is big enough, else
// make one, and hand it back. The fresh buffer flows to Put, so it is heap.
//
//go:noinline
func placePoolRoundTrip(n int) int {
	buf, _ := placePool.Get().([]byte)
	if cap(buf) < n {
		// amd64:1"CALL.*runtime\\.makeslice"
		// amd64:-"CALL.*runtime\\.logosArenaMakeSlice"
		buf = make([]byte, n)
	}
	buf = buf[:n]
	used := placeConsume(buf)
	placePool.Put(buf)
	return used
}

// Placement is decided per make site: the scratch buffer is arena-eligible
// and the buffer kept in a global is not, inside one function.
//
//go:noinline
func placeMixed(n int) int {
	// amd64:1"CALL.*runtime\\.logosArenaMakeSlice"
	// amd64:-"CALL.*runtime\\.makeslice"
	scratch := make([]byte, n)
	// amd64:1"CALL.*runtime\\.makeslice"
	// amd64:-"CALL.*runtime\\.logosArenaMakeSlice"
	kept := make([]byte, n)
	placeSink = kept
	return placeConsume(scratch)
}

func main() {
	placeTotal += placeDynamic(1 << 16)
	placeTotal += placeDynamicCap(1 << 16)
	placeTotal += placeGlobalStore(1 << 16)
	placeTotal += placePoolPut(1 << 16)
	placeTotal += placePoolRoundTrip(1 << 16)
	placeTotal += placeMixed(1 << 16)
}
