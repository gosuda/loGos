// asmcheck -goexperiment logosgcmoving

package main

// M19-S8 regression: a store of a global pointer into a freshly allocated
// (known-zeroed) object needs no write barrier buffer entries, so the
// barrier region is empty and its merge Phi would be trivial. The immix
// line mark is still emitted ahead of the store.
type immixTrivialNode struct {
	s string
	n int
}

//go:noinline
func immixGlobalToFresh() *immixTrivialNode {
	// amd64:"CALL.*runtime\\.logosImmixStoreBarrier"
	return &immixTrivialNode{s: "immix", n: 1}
}

func main() {
	println(immixGlobalToFresh().n)
}
