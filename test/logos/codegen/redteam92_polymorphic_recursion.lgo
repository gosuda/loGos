// asmcheck -O=3

package main

// REDTEAM #92 (SPEC Sec 2.3, T-203.4; IMPLEMENTATION.md M18-S3):
// polymorphic recursion must terminate because specialization stops at
// type depth 4. The four flat calls below pin the boundary: three wraps
// specialize to a clone, four wraps keep the interface call. A directly
// recursive generic driver is rejected by the typechecker with an
// instantiation-cycle error, so ever-deeper nesting through wrap is the
// only compilable spelling of the attack, and the depth cap is what
// keeps it finite. recover keeps callees out of the inliner so the
// clone calls stay visible. This fixture pins the same boundary as
// test/logos/codegen/specialize_depth.lgo with row-92 identifiers; it
// carries no recursive driver.

type r92namer interface{ R92Name() string }

type r92leaf struct{}

func (r92leaf) R92Name() string { return "leaf" }

type r92wrap[T r92namer] struct{ in T }

func (w r92wrap[T]) R92Name() string { return w.in.R92Name() }

func r92show(n r92namer) string {
	_ = recover()
	return n.R92Name()
}

func main() {
	println(r92show(r92wrap[r92leaf]{}))                   // amd64:`CALL.*r92show.logosspec[0-9]+` arm64:`CALL.*r92show.logosspec[0-9]+`
	println(r92show(r92wrap[r92wrap[r92leaf]]{}))          // amd64:`CALL.*r92show.logosspec[0-9]+` arm64:`CALL.*r92show.logosspec[0-9]+`
	println(r92show(r92wrap[r92wrap[r92wrap[r92leaf]]]{})) // amd64:`CALL.*r92show.logosspec[0-9]+` arm64:`CALL.*r92show.logosspec[0-9]+`
	println(r92show(r92wrap[r92wrap[r92wrap[r92wrap[r92leaf]]]]{})) // amd64:`CALL.*main\.r92show\(SB\)` amd64:-`CALL.*r92show.logosspec` arm64:`CALL.*main\.r92show\(SB\)` arm64:-`CALL.*r92show.logosspec`
}
