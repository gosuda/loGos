// asmcheck -wb=false

package main

// M19-S7 attack (SPEC Sec 8.4, Sec 19.2, T-301.2), compiler half: with the
// write barrier off, which is how the zgc build compiles, a pointer store
// into a heap slot is one plain move with no write-barrier call or flag
// test. The routing of -gc=zgc to this compiler flag stays blocked behind
// the phase 2 mode gate, so the check names the flag, not the mode.

//go:noinline
func storePtr(slot **int, p *int) {
	// amd64:"MOVQ\\s+BX, \\(AX\\)"
	// amd64:-"CALL\\s+runtime\\.gcWriteBarrier"
	// amd64:-"CMPL\\s+runtime\\.writeBarrier"
	// arm64:"MOVD\\s+R1, \\(R0\\)"
	// arm64:-"CALL\\s+runtime\\.gcWriteBarrier"
	// arm64:-"MOVWU\\s+runtime\\.writeBarrier"
	*slot = p
}

func main() {
	x, y := 1, 2
	s := &x
	storePtr(&s, &y)
	println(*s)
}
