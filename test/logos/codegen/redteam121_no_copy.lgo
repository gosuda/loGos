// asmcheck -O=3

package main

// REDTEAM #121 (SPEC Sec 2.3, T-203.4; IMPLEMENTATION.md M13-S3): at -O=3
// the call r121cNames(ms) with a []*r121cMonster argument specializes to a
// clone whose parameter is the plain []*r121cMonster, so the call site
// passes ms as it is: no CovSlice conversion call, no allocation, no copy
// loop, and the method call inside the clone is a static call to
// (*r121cMonster).Name. recover keeps r121cNames out of the inliner. There
// is no Go twin: const views are loGo/s syntax. This is the #121 no-copy
// close-out probe; test/logos/run/redteam121_const_slice.lgo proves the
// output. Symbol names are distinct from
// test/logos/codegen/specialize_constslice.lgo, whose assertions this
// mirrors.

type r121cCreature interface {
	const Name() string
}

type r121cMonster struct{ name string }

//go:noinline
func (m *r121cMonster) Name() string { return m.name }

func r121cNames(cs const []r121cCreature) int {
	_ = recover()
	total := 0
	for _, c := range cs {
		total += len(c.Name()) // amd64:`CALL.*\(\*r121cMonster\)\.Name` arm64:`CALL.*\(\*r121cMonster\)\.Name`
	}
	return total
}

func main() {
	ms := []*r121cMonster{{name: "orc"}, {name: "imp"}}
	println(r121cNames(ms)) // amd64:`CALL.*r121cNames.logosspec[0-9]+` amd64:-`CALL.*CovSlice` amd64:-`CALL.*runtime\.(makeslice|newobject|growslice)` arm64:`CALL.*r121cNames.logosspec[0-9]+` arm64:-`CALL.*CovSlice` arm64:-`CALL.*runtime\.(makeslice|newobject|growslice)`
}
