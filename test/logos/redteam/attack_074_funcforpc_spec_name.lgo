// run -O=3

package main

// REDTEAM #74 (SPEC Sec 2.3, T-203.4; IMPLEMENTATION.md M13): a same-package
// call with a concrete argument for an interface parameter used solely as a
// method receiver clones the callee to `<f>·logosspec<N>` at O2/O3, and the
// linker must strip that suffix in pclntab so traces and FuncForPC print the
// base name. The attack is a mangled name surviving into a trace: any frame
// or FuncForPC result containing `·logosspec` fails.
//
// This fixture pins the middle-dot spec-clone strip only. Cold-section
// placement and the underscore comptime-copy form live in attack_009, which
// stays blocked on the `_logosct<N>` pclntab naming. Positive clone
// existence (nm shows the `·logosspec` symbol) is pinned by
// test/logos/run/specialize.lgo and test/logos/codegen/specialize.lgo in
// the M13 gate; this fixture pins the trace-name contract on top of it. A
// build that never specializes still passes here, so a failure means the
// strip is broken, never that cloning is missing.

import (
	"fmt"
	"os"
	"runtime"
	"strings"
)

type writer74 interface {
	Write(p []byte) (int, error)
}

type bufA74 struct{ n int }

func (b *bufA74) Write(p []byte) (int, error) {
	b.n += len(p)
	return len(p), nil
}

type bufB74 struct{ n int }

func (b *bufB74) Write(p []byte) (int, error) {
	b.n += len(p)
	return len(p), nil
}

//go:noinline
func assert74(tag string) {
	var pcs [16]uintptr
	n := runtime.Callers(2, pcs[:])
	frames := runtime.CallersFrames(pcs[:n])
	seenBase := false
	for {
		fr, more := frames.Next()
		fn := fr.Function
		if strings.Contains(fn, "·logosspec") || strings.Contains(fn, "·logosct") {
			fmt.Printf("FAIL %s mangled trace name %q\n", tag, fn)
			os.Exit(1)
		}
		if fn == "main.feed74" {
			seenBase = true
		}
		if !more {
			break
		}
	}
	pc, _, _, ok := runtime.Caller(1)
	if !ok {
		fmt.Printf("FAIL %s Caller unavailable\n", tag)
		os.Exit(1)
	}
	fn := runtime.FuncForPC(pc)
	if fn == nil {
		fmt.Printf("FAIL %s FuncForPC unknown\n", tag)
		os.Exit(1)
	}
	name := fn.Name()
	if strings.Contains(name, "·logosspec") || strings.Contains(name, "·logosct") {
		fmt.Printf("FAIL %s FuncForPC mangled %q\n", tag, name)
		os.Exit(1)
	}
	if name != "main.feed74" {
		fmt.Printf("FAIL %s FuncForPC unexpected %q\n", tag, name)
		os.Exit(1)
	}
	if !seenBase {
		fmt.Printf("FAIL %s base name missing from trace\n", tag)
		os.Exit(1)
	}
	fmt.Printf("%s-trace: ok\n", tag)
}

//go:noinline
func feed74(w writer74, p []byte) int {
	assert74("feed74")
	n, err := w.Write(p)
	if err != nil {
		panic("attack74: write failed")
	}
	return n
}

func main() {
	a := &bufA74{}
	b := &bufB74{}
	if feed74(a, []byte("ab")) != 2 {
		fmt.Println("FAIL feed74 short write through *bufA74")
		os.Exit(1)
	}
	var w writer74 = b
	if feed74(w, []byte("cd")) != 2 {
		fmt.Println("FAIL feed74 short write through *bufB74")
		os.Exit(1)
	}
	if a.n != 2 || b.n != 2 {
		fmt.Println("FAIL feed74 byte counts diverged")
		os.Exit(1)
	}
	fmt.Println("OK")
}
