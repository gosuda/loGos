// run

package main

import (
	"debug/elf"
	"errors"
	"fmt"
	"os"
	"os/exec"
	"path/filepath"
	"runtime"
	"strings"
)

// #105: codesign rejecting custom cold text section: a cold successor
// must sit last inside its function. It must not use a separate cold section.
// debug/elf + readelf -S + go tool nm prove no separate .cold section.

func fail() (int, error) {
	return 0, errors.New("boom")
}

func divide() (int, error) {
	v := fail()?
	return v, nil
}

func check(n int) int {
	if n < 0 {
		os.Exit(1)
	}
	return n
}

func checkELF(exe string) {
	f, err := elf.Open(exe)
	if err != nil {
		fmt.Printf("FAIL elf.Open: %v\n", err)
		os.Exit(1)
	}
	defer f.Close()

	for _, s := range f.Sections {
		if strings.Contains(s.Name, "cold") {
			fmt.Printf("FAIL found cold section in elf: %s\n", s.Name)
			os.Exit(1)
		}
	}
	fmt.Println("elf: no .cold section")
}

func checkReadelf(exe string) {
	readelfBin, err := exec.LookPath("readelf")
	if err != nil {
		fmt.Printf("FAIL lookpath readelf: %v\n", err)
		os.Exit(1)
	}
	out, err := exec.Command(readelfBin, "-S", exe).CombinedOutput()
	if err != nil {
		fmt.Printf("FAIL readelf -S: %v\n%s\n", err, out)
		os.Exit(1)
	}
	if strings.Contains(string(out), ".cold") {
		fmt.Printf("FAIL readelf found .cold section in %s\n%s\n", exe, out)
		os.Exit(1)
	}
	fmt.Println("readelf: no .cold section")
}

func checkNM(exe string) {
	binDir := filepath.Join(runtime.GOROOT(), "bin")
	goBin := filepath.Join(binDir, "go")
	if runtime.GOOS == "windows" {
		goBin += ".exe"
	}
	nmOut, err := exec.Command(goBin, "tool", "nm", exe).CombinedOutput()
	if err != nil {
		fmt.Printf("FAIL go tool nm: %v\n%s\n", err, nmOut)
		os.Exit(1)
	}
	for _, line := range strings.Split(string(nmOut), "\n") {
		fields := strings.Fields(line)
		if len(fields) >= 3 {
			sym := fields[len(fields)-1]
			if strings.Contains(sym, ".cold") {
				fmt.Printf("FAIL nm found .cold symbol: %s\n", sym)
				os.Exit(1)
			}
		}
	}
	fmt.Println("nm: no .cold section")
}

func main() {
	if _, err := divide(); err == nil {
		fmt.Println("FAIL expected divide error")
		os.Exit(1)
	}
	if v := check(3); v != 3 {
		fmt.Println("FAIL check(3)")
		os.Exit(1)
	}

	exe, err := os.Executable()
	if err != nil {
		fmt.Printf("FAIL os.Executable: %v\n", err)
		os.Exit(1)
	}

	checkELF(exe)
	checkReadelf(exe)
	checkNM(exe)
	fmt.Println("OK")
}
