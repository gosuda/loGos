// run -goexperiment logosgcmoving -gcflags=all=-lb

package main

import (
	"fmt"
	"syscall"
)

// #29: ZGC colored pointers rejected by kernel (SPEC Sec 19.2, T-301.2).
// Every syscall and cgo entry MUST untag pointers. With the ZGC load
// barrier enabled (-lb, as -gc=zgc passes the compiler for every package)
// a heap-buffer pipe roundtrip and scalar controls must keep working on
// the stock collector: the barrier and admission must preserve the ABI
// they will untag under a moving collector. A broken untag/admission
// fails here with EFAULT or corrupted bytes. Full colored-pointer and
// evacuation-during-syscall red needs the ZGC mode gate.

func check(err error, what string) {
	if err != nil {
		panic("attack029 " + what + ": " + err.Error())
	}
}

func writeAll(fd int, b []byte) {
	for len(b) > 0 {
		n, err := syscall.Write(fd, b)
		check(err, "write")
		if n <= 0 {
			panic("attack029 short write")
		}
		b = b[n:]
	}
}

func readFull(fd int, b []byte) {
	off := 0
	for off < len(b) {
		n, err := syscall.Read(fd, b[off:])
		check(err, "read")
		if n <= 0 {
			panic("attack029 short read")
		}
		off += n
	}
}

func roundtrip(msg []byte) {
	var p [2]int
	check(syscall.Pipe(p[:]), "pipe")
	r, w := p[0], p[1]
	writeAll(w, msg)
	got := make([]byte, len(msg))
	readFull(r, got)
	for i := range msg {
		if got[i] != msg[i] {
			panic("attack029 byte mismatch")
		}
	}
	check(syscall.Close(r), "close reader")
	check(syscall.Close(w), "close writer")
}

func main() {
	roundtrip([]byte("zgc-untag-029"))
	fmt.Println("small ok")
	large := make([]byte, 8192)
	for i := range large {
		large[i] = byte(i*31 + 7)
	}
	roundtrip(large)
	fmt.Println("large ok")
	r1, _, _ := syscall.RawSyscall(syscall.SYS_GETPID, 0, 0, 0)
	if r1 == 0 {
		panic("attack029 getpid returned 0")
	}
	fmt.Println("scalar ok")
}
