// run -O=3

package main

// #9: text cold RVO corrupting debugger output (SPEC Sec 1.5, Sec 2.3,
// Sec 2.5, T-105, T-203.4, T-205). Cold successors must stay last inside
// their function (no separate cold section), and traces must print base
// names without any clone suffix: `·logosspec<N>`, `·logosct<N>`, or the
// source-level comptime spelling `_logosct<N>`.
// The linker strips every terminal clone suffix in pclntab to a fixpoint
// (src/cmd/link/internal/ld/pcln_logos.go logosCloneBaseName, pinned by
// pcln_logos_test.go); the dotted ASCII form `.logosspec` is ordinary
// text and is never a suffix. Comptime copies are spliced source text so
// they keep the ASCII spelling `<f>_logosct<N>`, which the linker strips
// exactly like the middle-dot forms. This fixture checks all three: a
// specialization clone `feed·logosspec<N>` must trace as `main.feed`, a
// comptime copy `autowire_logosct<N>` must trace as its base without
// `_logosct`, and no `·logosct` may appear. Cold placement is proved the
// same way as #105: the built binary must contain no `.cold` section.

import (
	"comptime"
	"debug/elf"
	"errors"
	"fmt"
	"os"
	"os/exec"
	"runtime"
	"strings"
)

type sink interface {
	Put(p []byte) int
}

type ring struct{ n int }

//go:noinline
func (r *ring) Put(p []byte) int {
	r.n += len(p)
	return r.n
}

func assertNoMiddleDotSuffix(tag, want string) {
	var pcs [16]uintptr
	n := runtime.Callers(2, pcs[:])
	frames := runtime.CallersFrames(pcs[:n])
	seenBase := false
	for {
		fr, more := frames.Next()
		fn := fr.Function
		if strings.Contains(fn, "·logosspec") || strings.Contains(fn, "·logosct") || strings.Contains(fn, "_logosct") {
			fmt.Printf("FAIL %s mangled trace name %q\n", tag, fn)
			os.Exit(1)
		}
		if fn == want || strings.HasPrefix(fn, want+"[") {
			seenBase = true
		}
		if !more {
			break
		}
	}
	pc, _, _, ok := runtime.Caller(1)
	if !ok {
		fmt.Printf("FAIL %s Caller unavailable\n", tag)
		os.Exit(1)
	}
	fn := runtime.FuncForPC(pc)
	if fn == nil {
		fmt.Printf("FAIL %s FuncForPC unknown\n", tag)
		os.Exit(1)
	}
	name := fn.Name()
	if strings.Contains(name, "·logosspec") || strings.Contains(name, "·logosct") || strings.Contains(name, "_logosct") {
		fmt.Printf("FAIL %s FuncForPC mangled %q\n", tag, name)
		os.Exit(1)
	}
	if name != want && !strings.HasPrefix(name, want+"[") {
		fmt.Printf("FAIL %s FuncForPC unexpected %q want %q\n", tag, name, want)
		os.Exit(1)
	}
	if !seenBase {
		fmt.Printf("FAIL %s base name %q missing from trace\n", tag, want)
		os.Exit(1)
	}
	fmt.Printf("%s-trace: ok\n", tag)
}

//go:noinline
func feed(w sink, b []byte) int {
	_ = recover()
	assertNoMiddleDotSuffix("feed", "main.feed")
	total := 0
	for range 3 {
		total += w.Put(b)
	}
	return total
}

type container struct {
	Port int
	Host string
}

type serviceA struct {
	Port int
	Host string
}

func resolve[T any](c *container) T {
	var zero T
	switch any(zero).(type) {
	case int:
		return any(c.Port).(T)
	case string:
		return any(c.Host).(T)
	default:
		panic("unresolvable")
	}
}

//go:noinline
func autowire[T any](c *container) *T {
	assertNoMiddleDotSuffix("autowire", "main.autowire")
	var v T
	const for _, f := range comptime.Fields[T]() {
		v.[f] = resolve[f.Type](c)
	}
	return &v
}

func fail() (int, error) {
	return 0, errors.New("boom")
}

func divide() (int, error) {
	v := fail()?
	return v, nil
}

func checkNoCold(exe string) {
	f, err := elf.Open(exe)
	if err != nil {
		fmt.Printf("FAIL elf.Open: %v\n", err)
		os.Exit(1)
	}
	defer f.Close()
	for _, s := range f.Sections {
		if strings.Contains(s.Name, "cold") {
			fmt.Printf("FAIL found cold section in elf: %s\n", s.Name)
			os.Exit(1)
		}
	}
	fmt.Println("elf: no .cold section")
	readelfBin, err := exec.LookPath("readelf")
	if err != nil {
		fmt.Printf("FAIL lookpath readelf: %v\n", err)
		os.Exit(1)
	}
	out, err := exec.Command(readelfBin, "-S", exe).CombinedOutput()
	if err != nil {
		fmt.Printf("FAIL readelf -S: %v\n%s\n", err, out)
		os.Exit(1)
	}
	if strings.Contains(string(out), ".cold") {
		fmt.Printf("FAIL readelf found .cold section\n%s\n", out)
		os.Exit(1)
	}
	fmt.Println("readelf: no .cold section")
}

//logos:allow(complexity::cognitive_overflow)
func main() {
	r := &ring{}
	_ = feed(r, []byte("ab"))
	var s sink = r
	_ = feed(s, []byte("cd"))
	c := &container{Port: 8080, Host: "db"}
	a := autowire[serviceA](c)
	if a.Port != 8080 || a.Host != "db" {
		fmt.Println("FAIL autowire values")
		os.Exit(1)
	}
	if _, err := divide(); err == nil {
		fmt.Println("FAIL divide expected error")
		os.Exit(1)
	}
	exe, err := os.Executable()
	if err != nil {
		fmt.Printf("FAIL os.Executable: %v\n", err)
		os.Exit(1)
	}
	checkNoCold(exe)
	fmt.Println("OK")
}
