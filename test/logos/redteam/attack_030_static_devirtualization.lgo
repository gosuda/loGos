// asmcheck -O=3

package main

// #30: Self-modifying inline cache causing cache thrashing
// (SPEC Sec 2.3, T-203.4). Devirtualization MUST stay static with no
// runtime writes. No call-site cache MUST exist. At -O=3 a same-package
// direct call with a concrete argument clones with the interface parameter
// retyped, so the method inside the clone is a static call; an interface
// value, a nil-compared parameter, and a reassigned parameter MUST keep
// the interface call with no clone. recover keeps the callees out of the
// inliner so the call sites stay visible. A hidden per-site or global
// cache would fold the interface-value and blocked sites to cached
// concrete targets; these patterns pin the static emission instead.

type c30sink interface {
	Put(p []byte) int
}

type c30ring struct{ n int }

//go:noinline
func (r *c30ring) Put(p []byte) int {
	r.n += len(p)
	return r.n
}

func c30feed(w c30sink, b []byte) int {
	_ = recover()
	total := 0
	for range 3 {
		total += w.Put(b) // amd64:`CALL.*\(\*c30ring\)\.Put` arm64:`CALL.*\(\*c30ring\)\.Put`
	}
	return total
}

func c30nilBlock(w c30sink) string {
	_ = recover()
	if w == nil {
		return "nil"
	}
	return "live"
}

func c30reassign(w c30sink, b []byte) int {
	_ = recover()
	n := w.Put(b)
	w = nil
	_ = w
	return n
}

func main() {
	r := &c30ring{}
	println(c30feed(r, []byte("ab"))) // amd64:`CALL.*c30feed.logosspec[0-9]+` arm64:`CALL.*c30feed.logosspec[0-9]+`
	var s c30sink = r
	println(c30feed(s, []byte("cd"))) // amd64:`CALL.*main\.c30feed\(SB\)` amd64:-`CALL.*c30feed.logosspec` arm64:`CALL.*main\.c30feed\(SB\)` arm64:-`CALL.*c30feed.logosspec`
	println(c30nilBlock(r)) // amd64:`CALL.*main\.c30nilBlock\(SB\)` amd64:-`CALL.*c30nilBlock.logosspec` arm64:`CALL.*main\.c30nilBlock\(SB\)` arm64:-`CALL.*c30nilBlock.logosspec`
	println(c30reassign(r, []byte("ef"))) // amd64:`CALL.*main\.c30reassign\(SB\)` amd64:-`CALL.*c30reassign.logosspec` arm64:`CALL.*main\.c30reassign\(SB\)` arm64:-`CALL.*c30reassign.logosspec`
}
