// errorcheck -0

// suspicious::defer_in_loop (LINT-RULES.md Sec 1.2): detects defer inside
// loops delaying resource release until function exit.

package p

func cleanup() {}

func badLoop(files []string) {
	for range files {
		defer cleanup() // ERROR "\[suspicious::defer_in_loop\]"
	}
	for i := range len(files) {
		if i%2 == 0 {
			defer cleanup() // ERROR "\[suspicious::defer_in_loop\]"
		}
	}
}

func cleanLoop(files []string) {
	defer cleanup()
	for range files {
		func() {
			defer cleanup()
		}()
	}
}
